#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def "Bee" (
        active = true
        prepend references = @Bee/Sources/Bee/Bee.rkassets/Bee.usda@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
