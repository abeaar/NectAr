    }

    def "Iphone" (
        active = true
        prepend references = @Iphone/Sources/Iphone/Iphone.rkassets/Iphone.usda@
    )
    {
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (-0.22713648, 0, -0.4549967)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

