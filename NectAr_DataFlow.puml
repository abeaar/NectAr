@startuml NectAr_DataFlow

skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultTextAlignment center

title NectAr — Actual Data Flow (vs ideal Model-Repository-Service-Controller-VM-View)

package "Model" {
  [AppPhase]
  [PlacedTopology]
  [DeviceKind / DeviceAttributes]
  [RouterAttributes]
  [TrackingFailureReason]
}

package "Service" as ServiceLayer {
  [ARSessionManager]
  [AnchoredEntityPlacer]
  [DeviceEntityLoader]
  [PreparationPreviewStyler]
  [SimulationObstructionChecker]
  [SimulationRangeChecker]
  [SimulationRouteResolver]
}

package "Controller (fat — state machine + scene ownership)" as ControllerLayer {
  [PreparationSceneController]
  [PreparationLedger] #LightYellow
  note right of [PreparationLedger]
    In-memory store —
    plays the role a
    Repository would
    (no real Repository
    layer exists)
  end note
  [MascotOnboardingController]
  [SimulationSceneController]
}

package "ViewModel (thin — facade/composer)" as VMLayer {
  [ARViewModel]
  [PreparationViewModel]
  [SimulationViewModel]
}

package "View" {
  [PreparationView]
  [SimulationContainerView]
  [HintTextView]
  [PreparationActionButton]
}

' --- Service layer usage ---
ARSessionManager --> TrackingFailureReason : sets on\ndelegate callback
PreparationSceneController --> DeviceEntityLoader : load(kind)
PreparationSceneController --> AnchoredEntityPlacer : place(entity)
PreparationSceneController --> PreparationPreviewStyler : style ghost preview
PreparationSceneController --> PreparationLedger : record transform
SimulationSceneController --> SimulationRouteResolver : resolve route
SimulationSceneController --> SimulationObstructionChecker : check wall
SimulationSceneController --> SimulationRangeChecker : check range

' --- Controller -> Model ---
PreparationLedger --> PlacedTopology : builds

' --- ViewModel composes Controllers/Services ---
ARViewModel --> ARSessionManager : wraps (ARSessionManaging)
PreparationViewModel --> ARViewModel : merges hintText
PreparationViewModel --> PreparationSceneController : forwards intent /\nreads hint
PreparationViewModel --> MascotOnboardingController : reads phase / hint
SimulationViewModel --> SimulationSceneController : forwards commands

' --- View -> ViewModel (declarative + imperative calls) ---
PreparationView --> PreparationViewModel : viewModel.start()\nviewModel.tapActionButton\nviewModel.hintText
PreparationView --> HintTextView : hintText: viewModel.hintText
PreparationView --> PreparationActionButton : action: viewModel.tapActionButton
SimulationContainerView --> SimulationViewModel : viewModel.attachARView()\n(called inside makeUIView)

' --- End to end flow example ---
PlacedTopology ..> SimulationSceneController : passed as payload\nwhen phase = .simulation

legend right
  |= Layer |= Ideal role (tech-lead pattern) |= Actual role here |
  | Model | data struct | data struct (matches) |
  | Repository | data access (get/list) | **absent** — replaced by\nin-memory Controller state (PreparationLedger) |
  | Service | logic functions | stateless logic + thin\nARSession wrapper (matches) |
  | Controller | bundles services | **fat**: state machine +\ndirect RealityKit/ARView ownership |
  | ViewModel | calls controller | **thin**: facade that composes\nmultiple controllers/services |
  | View | renders VM data | binds to VM, but also calls\nimperative methods directly |
endlegend

@enduml
